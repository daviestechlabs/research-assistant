{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9./:_-]+$"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        },
        "required": [
          "name"
        ]
      },
      "maxItems": 8
    },
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "catalogFile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+[.]sqlite$"
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 14336
        }
      },
      "required": [
        "existingClaim",
        "catalogFile",
        "memoryMiB"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^/]+/.+/$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "allowedSubjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "publicOrigin": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[a-zA-Z0-9.-]+$"
        },
        "originAddress": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "audience",
        "allowedSubjects",
        "publicOrigin"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^http://litellm[.][a-z0-9-]+[.]svc[.]cluster[.]local:4000/v1/chat/completions$"
        },
        "model": {
          "type": "string",
          "enum": [
            "smart-local",
            "fast-local"
          ]
        },
        "secretName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "required": [
        "url",
        "model",
        "secretName",
        "secretKey"
      ]
    },
    "nas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "accessKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "httpCIDR": {
          "type": "string",
          "pattern": "^$|^[0-9.]+/(3[0-2]|[12]?[0-9])$"
        },
        "endpoint": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "pdfPrefix": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "pdfShards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "secretName",
        "accessKey",
        "secretKey"
      ]
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rerankURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "embeddingOrigin": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "vectorOrigin": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "catalogSHA256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "embeddingSHA256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "required": [
        "rerankURL",
        "embeddingOrigin",
        "vectorOrigin",
        "catalogSHA256",
        "embeddingSHA256"
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              },
              "sectionName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            },
            "required": [
              "name",
              "namespace",
              "sectionName"
            ]
          },
          "maxItems": 4
        },
        "oidcSecretName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "authorizationEndpoint": {
          "type": "string"
        },
        "tokenEndpoint": {
          "type": "string"
        },
        "endSessionEndpoint": {
          "type": "string"
        },
        "providerBackend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "name",
            "namespace",
            "port"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gatewayNamespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "modelNamespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "required": [
        "gatewayNamespace",
        "modelNamespace"
      ]
    },
    "suspend": {
      "type": "boolean"
    },
    "legacyDeployment": {
      "type": "boolean"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "iconAlt": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "configMapName": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "name",
        "iconAlt",
        "description",
        "configMapName"
      ]
    },
    "books": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestFile": {
          "type": "string",
          "enum": [
            "",
            "/private-config/books.json"
          ]
        },
        "planSHA256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "manifestFile",
        "planSHA256",
        "count"
      ]
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "directory": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "credentialEnv": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretName",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^RESEARCH_INDEX_[A-Z][A-Z0-9_]{0,80}$"
              },
              "secretName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,100}$"
              }
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9]+([.][0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "nasCIDRs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
          }
        },
        "nasPorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "trustConfigMapName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      },
      "required": [
        "enabled",
        "configMapName",
        "directory",
        "credentialEnv",
        "nodeSelector",
        "resources",
        "nasCIDRs",
        "nasPorts",
        "trustConfigMapName"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "configMapName": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "storage",
    "auth",
    "inference",
    "nas",
    "image",
    "retrieval",
    "resources",
    "network"
  ]
}
